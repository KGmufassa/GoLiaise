{
  "type": "object",
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^EXPERIMENT-.+"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "value_proposition": {
      "type": "string",
      "minLength": 1
    },
    "signup_offer": {
      "type": "string",
      "minLength": 1
    },
    "desired_metrics": {
      "type": "array"
    },
    "measurement_window": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "hosting": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "collection_method": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "cost_assumptions": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "method",
        "collection_method",
        "rationale",
        "cost_assumptions"
      ],
      "additionalProperties": true
    },
    "publication": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pending",
            "published",
            "blocked"
          ]
        },
        "url": {
          "type": "string"
        },
        "published_at": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "url",
        "published_at"
      ],
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "properties": {
        "public_url": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "passed",
                "failed"
              ]
            },
            "checked_at": {
              "type": "string",
              "minLength": 1
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "checked_at",
            "evidence_refs"
          ],
          "additionalProperties": true
        },
        "signup_persistence": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "passed",
                "failed"
              ]
            },
            "checked_at": {
              "type": "string",
              "minLength": 1
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "checked_at",
            "evidence_refs"
          ],
          "additionalProperties": true
        },
        "success_error_states": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "passed",
                "failed"
              ]
            },
            "checked_at": {
              "type": "string",
              "minLength": 1
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "checked_at",
            "evidence_refs"
          ],
          "additionalProperties": true
        },
        "duplicate_handling": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "passed",
                "failed"
              ]
            },
            "checked_at": {
              "type": "string",
              "minLength": 1
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "checked_at",
            "evidence_refs"
          ],
          "additionalProperties": true
        },
        "spam_protection": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "passed",
                "failed"
              ]
            },
            "checked_at": {
              "type": "string",
              "minLength": 1
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "checked_at",
            "evidence_refs"
          ],
          "additionalProperties": true
        },
        "mobile_layout": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "passed",
                "failed"
              ]
            },
            "checked_at": {
              "type": "string",
              "minLength": 1
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "checked_at",
            "evidence_refs"
          ],
          "additionalProperties": true
        },
        "accessibility": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "passed",
                "failed"
              ]
            },
            "checked_at": {
              "type": "string",
              "minLength": 1
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "checked_at",
            "evidence_refs"
          ],
          "additionalProperties": true
        },
        "measurement": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "passed",
                "failed"
              ]
            },
            "checked_at": {
              "type": "string",
              "minLength": 1
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "checked_at",
            "evidence_refs"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "public_url",
        "signup_persistence",
        "success_error_states",
        "duplicate_handling",
        "spam_protection",
        "mobile_layout",
        "accessibility",
        "measurement"
      ],
      "additionalProperties": true
    },
    "metrics": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "awaiting_evidence",
            "observed"
          ]
        },
        "visits": {
          "type": "integer",
          "minimum": 0
        },
        "completed_signups": {
          "type": "integer",
          "minimum": 0
        },
        "conversion_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "traffic_sources": {
          "type": "array"
        },
        "observation_start": {
          "type": "string",
          "minLength": 1
        },
        "observation_end": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "observed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "visits",
              "completed_signups",
              "conversion_rate",
              "traffic_sources",
              "observation_start",
              "observation_end"
            ]
          }
        }
      ]
    },
    "limitations": {
      "type": "array"
    },
    "follow_up_actions": {
      "type": "array"
    },
    "core_features_ref": {
      "type": "string",
      "minLength": 1
    },
    "deployment_strategy_ref": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "const": "Stage 4"
    },
    "approved_decisions": {
      "type": "object",
      "properties": {
        "core_features_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "stack_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "strategy_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "core_features_hash",
        "stack_hash",
        "strategy_hash"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "experiment_id",
    "source_refs",
    "audience",
    "value_proposition",
    "signup_offer",
    "desired_metrics",
    "measurement_window",
    "owner",
    "hosting",
    "publication",
    "verification",
    "metrics",
    "limitations",
    "follow_up_actions",
    "core_features_ref",
    "deployment_strategy_ref",
    "approved_decisions"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "waitlist-validation.schema.json",
  "title": "Stage 4 Waitlist Validation",
  "allOf": [
    {
      "$ref": "stage-4-output.schema.json"
    }
  ]
}
