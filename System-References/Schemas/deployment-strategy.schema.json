{
  "type": "object",
  "properties": {
    "strategy_id": {
      "type": "string",
      "pattern": "^INFRA-.+"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "web",
          "ios",
          "android"
        ]
      }
    },
    "backend_hosting": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "enum": [
              "web",
              "ios",
              "android"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "alternatives": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "minLength": 1
                },
                "disposition": {
                  "enum": [
                    "selected",
                    "rejected"
                  ]
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "method",
                "disposition",
                "rationale"
              ],
              "additionalProperties": true
            }
          },
          "runtime_fit": {
            "type": "string",
            "minLength": 1
          },
          "cost_assumptions": {
            "type": "string",
            "minLength": 1
          },
          "operational_burden": {
            "type": "string",
            "minLength": 1
          },
          "build_toolchain": {
            "type": "string",
            "minLength": 1
          },
          "signing": {
            "type": "string",
            "minLength": 1
          },
          "test_distribution": {
            "type": "string",
            "minLength": 1
          },
          "distribution_channel": {
            "type": "string",
            "minLength": 1
          },
          "developer_accounts": {
            "type": "string",
            "minLength": 1
          },
          "release_process": {
            "type": "string",
            "minLength": 1
          },
          "update_process": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "platform",
          "method",
          "rationale",
          "alternatives",
          "runtime_fit",
          "cost_assumptions",
          "operational_burden"
        ],
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "platform": {
                  "enum": [
                    "ios",
                    "android"
                  ]
                }
              },
              "required": [
                "platform"
              ]
            },
            "then": {
              "required": [
                "build_toolchain",
                "signing",
                "test_distribution",
                "distribution_channel",
                "developer_accounts",
                "release_process",
                "update_process"
              ]
            }
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "accessed_at": {
            "type": "string",
            "minLength": 1
          },
          "finding": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "url",
          "accessed_at",
          "finding"
        ],
        "additionalProperties": true
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "requirement",
          "owner",
          "next_action"
        ],
        "additionalProperties": true
      }
    },
    "risks": {
      "type": "array"
    },
    "stack_compatibility": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "compatible",
            "incompatible",
            "unresolved"
          ]
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unresolved_blockers": {
          "type": "array"
        }
      },
      "required": [
        "status",
        "findings",
        "unresolved_blockers"
      ],
      "additionalProperties": true
    },
    "approval": {
      "type": "object",
      "properties": {
        "approval_status": {
          "enum": [
            "pending",
            "approved",
            "revision_requested",
            "blocked"
          ]
        },
        "approved_by": {
          "type": "string"
        },
        "approved_at": {
          "type": "string"
        },
        "brief_ref": {
          "type": "string",
          "minLength": 1
        },
        "core_features_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "stack_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "strategy_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "approval_status",
        "approved_by",
        "approved_at",
        "brief_ref",
        "core_features_hash",
        "stack_hash",
        "strategy_hash"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "strategy_id",
    "source_refs",
    "required_targets",
    "backend_hosting",
    "targets",
    "sources",
    "prerequisites",
    "risks",
    "stack_compatibility",
    "approval"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deployment-strategy.schema.json",
  "title": "Stage 3 Deployment Strategy",
  "allOf": [
    {
      "$ref": "stage-3-output.schema.json"
    }
  ]
}
